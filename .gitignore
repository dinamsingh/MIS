# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

node_modules
dist
dist-ssr
*.local

# Environment
.env
.env.*
!.env.example
# Cloudflare Pages Functions local secrets (holds the Gemini key) — NEVER commit.
.dev.vars
# .env.production is committed on purpose — it holds only PUBLIC client-side
# values (anon key, URLs) so Cloudflare's git build bakes them in. No secrets here.
!.env.production

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
# SQL dummy data / local seed scripts
*.sql
SEED_300_STUDENTS.sql
# ...but DO track the project's real migrations and seed scripts (source of truth)
!src/data/migrations/*.sql
!src/data/seeds/*.sql

